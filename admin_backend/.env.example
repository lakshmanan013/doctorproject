# Copy to .env (or export these in your shell) before running the backend.
# None are required — every value has a sensible default for local dev.

# --- Server ---
PORT=5000

# --- Database driver switch ---
# "h2"    -> zero-setup embedded file database at ./data/vetcare (default)
# "mysql" -> connect to a real MySQL server using the settings below
DB_DRIVER=h2

# --- MySQL (used when DB_DRIVER=mysql) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vetcare
DB_USER=root
DB_PASSWORD=Vasanth@zenve
# --- H2 (used when DB_DRIVER=h2) ---
DB_FILE_PATH=./data/vetcare

# --- Auth ---
JWT_SECRET=change-this-super-secret-key-for-zenve-admin-please-override-in-prod
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5174

# --- Seeded admin account (created on first boot) ---
SEED_ADMIN_NAME=Zenve Admin
SEED_ADMIN_EMAIL=admin@zenve.in
SEED_ADMIN_PASSWORD=Admin-123
